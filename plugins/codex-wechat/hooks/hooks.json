{
  "description": "Project-scoped WeChat inbox hooks; the host retains Session ownership.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/bootstrap.sh\"",
            "timeout": 60,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/bootstrap.sh\"",
            "timeout": 60,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/bootstrap.sh\"",
            "timeout": 60,
            "additionalContextLimit": 1200
          }
        ]
      }
    ]
  }
}

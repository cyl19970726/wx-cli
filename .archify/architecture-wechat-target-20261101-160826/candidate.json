  "cards": [
    {
      "dot": "cyan",
      "title": "两种形态共用底座",
      "items": [
        "pull：专属 Session 主动用 CLI 查看历史、判断、发文字或图片。",
        "push：新消息先入该 Session 的持久收件箱，忙时等待，空闲后处理。",
        "推送不是强制回复；skip、defer、draft 都是合法结果。"
      ]
    },
    {
      "dot": "violet",
      "title": "读和想并行，桌面发串行",
      "items": [
        "每个群／私聊有独立 owner、进度和上下文；同会话一个处理租约。",
        "所有 Session 只提交意图；不各自抢剪贴板或点微信。",
        "人工接管 A 会话只停 A 的自动处理；桌面本身不安全时则停全部 GUI 发送。"
      ]
    },
    {
      "dot": "amber",
      "title": "明确标为设计，不冒充现状",
      "items": [
        "这张是目标方案，包含尚未实现的收件箱、Session 投递和持久发送队列。",
        "图片 PR #5 是已有代码候选，真实发送与独立收件仍待验收。",
        "企业微信 API 适配器与 MCP 后置；不在这张个人微信 GUI 图中混画。"
      ]
    },
    {
      "dot": "rose",
      "title": "恢复与不确定结果",
      "items": [
        "通知漏建：按事件日志补齐；重复 delivery：返回原处理结果。",
        "Session 或发送请求结果不明：先核对原回合／attempt，不新建替身或换 ID 重发。",
        "桌面清理与核查完成才恢复发送；独立收件确认保留为证据等级，不逐条阻塞整个队列。"
      ]
    }
  ]
